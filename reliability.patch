diff --git a/src/utils/version.go b/src/utils/version.go
new file mode 100644
--- /dev/null
+++ b/src/utils/version.go
@@ -0,0 +1,50 @@
+package utils
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// CompareVersions compares the first three numeric components of version strings.
+// Spotify build metadata after the patch component is intentionally ignored, so
+// values such as "1.2.82.428.g0ac8be2b" compare as "1.2.82".
+func CompareVersions(left, right string) (int, error) {
+	parse := func(value string) ([3]int, error) {
+		var result [3]int
+		parts := strings.Split(strings.TrimSpace(value), ".")
+		if len(parts) < 3 {
+			return result, fmt.Errorf("version %q must contain major, minor, and patch components", value)
+		}
+		for i := 0; i < len(result); i++ {
+			part := strings.TrimSpace(parts[i])
+			if part == "" {
+				return result, fmt.Errorf("version %q has an empty component", value)
+			}
+			n, err := strconv.Atoi(part)
+			if err != nil || n < 0 {
+				return result, fmt.Errorf("version %q has an invalid numeric component %q", value, part)
+			}
+			result[i] = n
+		}
+		return result, nil
+	}
+
+	a, err := parse(left)
+	if err != nil {
+		return 0, err
+	}
+	b, err := parse(right)
+	if err != nil {
+		return 0, err
+	}
+	for i := 0; i < len(a); i++ {
+		if a[i] < b[i] {
+			return -1, nil
+		}
+		if a[i] > b[i] {
+			return 1, nil
+		}
+	}
+	return 0, nil
+}

diff --git a/src/utils/version_test.go b/src/utils/version_test.go
new file mode 100644
--- /dev/null
+++ b/src/utils/version_test.go
@@ -0,0 +1,39 @@
+package utils
+
+import "testing"
+
+func TestCompareVersions(t *testing.T) {
+	tests := []struct {
+		left, right string
+		want        int
+	}{
+		{"1.2.56.123.gabc", "1.2.57", -1},
+		{"1.2.57", "1.2.57", 0},
+		{"1.2.82.428.g0ac8be2b", "1.2.57", 1},
+		{"1.3.0.0.gabc", "1.2.57", 1},
+		{"1.10.0", "1.9.99", 1},
+		{"2.0.0", "1.99.99", 1},
+		{"1.1.100", "1.2.28", -1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.left+"_vs_"+tt.right, func(t *testing.T) {
+			got, err := CompareVersions(tt.left, tt.right)
+			if err != nil {
+				t.Fatalf("CompareVersions returned error: %v", err)
+			}
+			if got != tt.want {
+				t.Fatalf("CompareVersions(%q, %q) = %d, want %d", tt.left, tt.right, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestCompareVersionsRejectsMalformedInput(t *testing.T) {
+	for _, input := range []string{"", "Dev", "1.2", "1.x.3", "1.-2.3"} {
+		t.Run(input, func(t *testing.T) {
+			if _, err := CompareVersions(input, "1.2.57"); err == nil {
+				t.Fatalf("expected malformed version %q to be rejected", input)
+			}
+		})
+	}
+}

