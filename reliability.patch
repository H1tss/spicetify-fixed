+// ValidateAdditionalOptions checks essential inputs before Apply overwrites the
+// user's Spotify Apps directory. In particular, it refuses unsupported custom-app
+// injection instead of printing an error and continuing with a partial apply.
+func ValidateAdditionalOptions(appsFolderPath string, flags Flag) error {
+	if _, err := utils.CompareVersions(flags.SpotifyVer, "1.2.57"); err != nil {
+		return fmt.Errorf("cannot determine Spotify version from %q; check the Spotify prefs path and run `spicetify backup` again: %w", flags.SpotifyVer, err)
+	}
+
+	indexPath := filepath.Join(appsFolderPath, "xpui", "index.html")
+	if _, err := os.Stat(indexPath); err != nil {
+		return fmt.Errorf("Spotify's extracted app files are incomplete (missing xpui/index.html); run `spicetify restore backup apply` after checking the Spotify installation: %w", err)
+	}
+
+	if len(flags.CustomApp) > 0 && findCustomAppTarget(appsFolderPath) == "" {
+		return fmt.Errorf("Spotify's JavaScript bundle does not match the custom-app injector; no files were modified. Update Spicetify, or temporarily remove custom apps from config and apply again")
+	}
+
+	helpers := []struct { enabled bool; name string }{
+		{flags.SidebarConfig, "sidebarConfig.js"},
+		{flags.HomeConfig, "homeConfig.js"},
+		{flags.ExpFeatures, "expFeatures.js"},
+	}
+	for _, helper := range helpers {
+		if !helper.enabled { continue }
+		if _, err := os.Stat(filepath.Join(utils.GetJsHelperDir(), helper.name)); err != nil {
+			return fmt.Errorf("required Spicetify helper %q is unavailable: %w", helper.name, err)
+		}
+	}
+	return nil
+}

